{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghost-terminal-ai-demo",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMIT",
      "namespace_id": "2026102901",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMIT",
      "namespace_id": "2026102902",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
